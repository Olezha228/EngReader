    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.9",
    "expo-sharing": "~58.0.19",
    "expo-speech": "~58.0.3",
    "expo-sqlite": "~58.0.13",
    "expo-status-bar": "~58.0.3",
    "expo-web-browser": "~58.0.6",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-webview": "14.0.1",
    "ts-fsrs": "^5.4.2"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.43",
    "@types/react": "~19.3.0",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.0",
    "typescript": "~6.0.3"
